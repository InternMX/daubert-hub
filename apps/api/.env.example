# Copy to apps/api/.env for local API development. Do not use production credentials.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=daubert_hub_dev
DB_USER=postgres
DB_PASSWORD=change-me
API_PORT=3000
# Session cookie Secure flag: false for local HTTP dev/TEST, true once served over HTTPS.
AUTH_COOKIE_SECURE=false

# PN1.2: Hub -> n8n server-to-server webhook for Payment Notifications' Reprocesar manual
# control. Optional — omit entirely to leave that action returning a sanitized
# upstream-unavailable response. Never commit real values; the token must also be configured as
# the n8n Webhook Trigger node's Header Auth credential, never in frontend config.
# PAYMENT_NOTIFICATIONS_REPROCESS_WEBHOOK_URL=
# PAYMENT_NOTIFICATIONS_WEBHOOK_TOKEN=

# Hub -> n8n availability check (GET /api/system/status) via the "Daubert Hub - n8n Health Check"
# workflow. Optional — omit to report "n8n sin configurar". The token is the value of the n8n
# Header Auth credential (header X-Daubert-Automation-Token). Never commit real values.
# N8N_HEALTH_WEBHOOK_URL=http://localhost:5678/webhook/daubert-hub/health
# N8N_HEALTH_WEBHOOK_TOKEN=

# BIND ERP (manufacturing sheets, phase 2): read-only product lookup via https://api.bind.com.mx. Optional - omit to report NOT_CONFIGURED at call time.
# The API key (Authorization: Bearer) and the optional developer-portal subscription key (Ocp-Apim-Subscription-Key) live ONLY here, in the backend environment:
# never commit real values, never log them, never send them to the frontend. BIND_API_BASE_URL must be https and a *.bind.com.mx host (default https://api.bind.com.mx).
# BIND_API_KEY=
# BIND_SUBSCRIPTION_KEY=
# BIND_API_BASE_URL=https://api.bind.com.mx
