# Aislamiento de TEST para la demostración (se carga AL FINAL: prevalece sobre deploy/pilot.test.env). Sin secretos.
# Caterpillar: el webhook de TEST apuntaba al n8n operativo (host.docker.internal:5678/webhook-test/...). Se sustituye por un puerto cerrado
# del propio contenedor (127.0.0.1:9 dentro de la API: conexión rechazada al instante) y un token sintético: el token de TEST no entra al contenedor.
CATERPILLAR_REPROCESS_WEBHOOK_URL=http://127.0.0.1:9/bloqueado-demo-test
CATERPILLAR_REPROCESS_WEBHOOK_TOKEN=token-sintetico-demo-sin-destino
# Pagos y salud de n8n: vacíos = funciones desactivadas (la API no hace ninguna llamada).
PAYMENT_NOTIFICATIONS_REPROCESS_WEBHOOK_URL=
PAYMENT_NOTIFICATIONS_WEBHOOK_TOKEN=
N8N_HEALTH_WEBHOOK_URL=
N8N_HEALTH_WEBHOOK_TOKEN=
PAYMENT_FILE_ASSIGNMENTS_PROD_ENABLED=false
PAYMENT_FILE_ASSIGNMENTS_PROD_N8N_READY=false
PAYMENT_FILE_ASSIGNMENTS_PROD_N8N_ORIGIN=
# BIND: sin credenciales (la consulta responde "no configurado"; la demostración usa captura manual).
BIND_API_KEY=
BIND_SUBSCRIPTION_KEY=
BIND_API_BASE_URL=
# Cookies: TEST se sirve por http://127.0.0.1:8081.
AUTH_COOKIE_SECURE=false
