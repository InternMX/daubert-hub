HUB_PORT=8080
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=daubert_global
DB_USER=daubert_hub_app
DB_PASSWORD=CHANGE_ME
API_PORT=3000
# n8n availability indicator (GET /api/system/status). Optional; leave the token empty here and
# set the real value only in the untracked deploy/pilot.prod.env.
N8N_HEALTH_WEBHOOK_URL=http://host.docker.internal:5678/webhook/daubert-hub/health
N8N_HEALTH_WEBHOOK_TOKEN=
