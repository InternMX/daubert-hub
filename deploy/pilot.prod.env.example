HUB_PORT=8080
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=daubert_global
DB_USER=daubert_hub_app
DB_PASSWORD=CHANGE_ME
API_PORT=3000
# n8n availability indicator (GET /api/system/status). Optional; leave the token empty here and
# set the real value only in the untracked deploy/pilot.prod.env.
N8N_HEALTH_WEBHOOK_URL=http://host.docker.internal:5678/webhook/daubert-hub/health
N8N_HEALTH_WEBHOOK_TOKEN=

# Notificaciones de pago (reproceso Hub -> n8n y asignacion puntual por archivo). Todo APAGADO por defecto.
# El reproceso productivo usa el webhook /webhook/daubert-hub/notificaciones-pago/reprocesar (Header Auth "Daubert Hub - n8n PROD").
# Dejar en blanco hasta ejecutar el runbook docs/automations/payment-notifications/production-rollout.md. Token solo en deploy/pilot.prod.env (sin versionar).
PAYMENT_NOTIFICATIONS_REPROCESS_WEBHOOK_URL=
PAYMENT_NOTIFICATIONS_WEBHOOK_TOKEN=
# Fase A (despues de aplicar 015-017): habilita la asignacion puntual (solo guardar). Fase B (despues de activar el workflow candidato): READY + origen.
PAYMENT_FILE_ASSIGNMENTS_PROD_ENABLED=false
PAYMENT_FILE_ASSIGNMENTS_PROD_N8N_READY=false
PAYMENT_FILE_ASSIGNMENTS_PROD_N8N_ORIGIN=
