HUB_PORT=8081
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=daubert_hub_test
DB_USER=daubert_hub_test_user
DB_PASSWORD=CHANGE_ME
API_PORT=3000
# Phase 12C: Caterpillar manual reprocess webhook (n8n TEST, executed manually via "Execute
# workflow" — see apps/api/src/automations/remisiones-caterpillar/caterpillar-reprocess-webhook.client.ts).
# Leave CATERPILLAR_REPROCESS_WEBHOOK_TOKEN empty here; set the real value only in the untracked
# deploy/pilot.test.env, matching whatever Header Auth credential secret is configured in n8n.
CATERPILLAR_REPROCESS_WEBHOOK_URL=http://host.docker.internal:5678/webhook-test/cat-test-reprocess
CATERPILLAR_REPROCESS_WEBHOOK_TOKEN=
# n8n availability indicator (GET /api/system/status). Optional; real token only in the untracked env.
N8N_HEALTH_WEBHOOK_URL=http://host.docker.internal:5678/webhook/daubert-hub/health
N8N_HEALTH_WEBHOOK_TOKEN=

# Manufactura (TEST). Con la base daubert_hub_test el modulo se habilita solo; estas lineas solo hacen explicito el entorno. La interfaz es de COMPILACION:
# construir la imagen web con VITE_MANUFACTURING_UI=true y VITE_MANUFACTURING_DOCUMENTS=true (ver docs/hub/manufactura-habilitacion-produccion.md).
MANUFACTURING_ENABLED=true
MANUFACTURING_EMISSION_ENV=PRUEBA
# Variables de COMPILACION de la imagen web (compose las pasa como build args; sin ellas la interfaz de Manufactura queda oculta):
VITE_MANUFACTURING_UI=true
VITE_MANUFACTURING_DOCUMENTS=true
# BIND ERP (solo lectura de productos); claves reales solo en el archivo sin versionar.
BIND_API_KEY=
BIND_SUBSCRIPTION_KEY=
