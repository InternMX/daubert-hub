# Manufactura en TEST: configuracion VERSIONADA y SIN secretos. Se pasa como segundo --env-file junto con el archivo local (sin versionar) deploy/pilot.test.env:
#   docker compose --project-name daubert-hub-test --env-file deploy/pilot.test.env --env-file deploy/pilot.test.manufacturing.env -f compose.pilot.yaml up -d --build
# Sin este archivo (o sin estas lineas en pilot.test.env) la imagen web se compila con la interfaz de Manufactura OCULTA (valor seguro para PROD).
# Si una variable aparece en ambos archivos gana la del ultimo --env-file.
#
# Variables de COMPILACION de la imagen web (build args de compose.pilot.yaml). No las lee la API en ejecucion:
VITE_MANUFACTURING_UI=true
VITE_MANUFACTURING_DOCUMENTS=true
# Variables de EJECUCION de la API (con la base daubert_hub_test ya son el valor por omision; se declaran para hacerlo explicito):
MANUFACTURING_ENABLED=true
MANUFACTURING_EMISSION_ENV=PRUEBA
# Las claves de BIND (BIND_API_KEY, BIND_SUBSCRIPTION_KEY) son SECRETOS: solo en deploy/pilot.test.env.
